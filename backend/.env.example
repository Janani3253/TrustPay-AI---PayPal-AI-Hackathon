APP_NAME=TrustPay AI
APP_ENV=development
DEBUG=true

# PostgreSQL Async Database Connection
# Local Development Example:
# DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/trustpay_ai
# Render Production Example:
# Render automatically injects DATABASE_URL in the format:
# postgres://user:password@dpg-xxxx-a.render.com/dbname
# TrustPay AI automatically normalizes this to postgresql+psycopg:// with sslmode=require
DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/trustpay_ai

# Database Engine & Connection Pool Settings
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & JWT Configuration
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=trustpay-ai
JWT_AUDIENCE=trustpay-ai-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Security & CORS
TRUSTPAY_SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated list of allowed frontend origins (e.g. your Render/Vercel frontend URL)
TRUSTPAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.onrender.com

# Legacy SQLite Store Path (Preserved for compatibility)
TRUSTPAY_DATABASE_PATH=./trustpay.db

# Product Providers & Caching (Phase 3)
DUMMYJSON_BASE_URL=https://dummyjson.com
DUMMYJSON_ENABLED=true
PRODUCT_REQUEST_TIMEOUT_SECONDS=10.0
PRODUCT_CACHE_TTL_SECONDS=300
PRODUCT_CATEGORY_CACHE_TTL_SECONDS=1800
PRODUCT_CACHE_MAX_ENTRIES=500
PRODUCT_MAX_PAGE_SIZE=200
PRODUCT_RETRY_ATTEMPTS=2

# Google Gemini AI & Intent Extraction (Phase 4)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=1
GEMINI_MAX_CONCURRENT_REQUESTS=5
INTENT_MAX_REQUEST_CHARS=4000
INTENT_MAX_OUTPUT_TOKENS=2000

# Prompt Injection & Content Security (Phase 5)
SECURITY_SCAN_MAX_CONTENT_CHARS=20000
SECURITY_SCAN_MAX_FIELDS=20
SECURITY_SCAN_MAX_FINDINGS=50
SECURITY_SCAN_MAX_GEMINI_OUTPUT_TOKENS=1500
SECURITY_SCAN_MAX_CONCURRENT_AI_REQUESTS=3
SECURITY_SCAN_CACHE_TTL_SECONDS=300
SECURITY_SCAN_CACHE_MAX_ENTRIES=500

# Payment & External Services (Phase 9)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
FRONTEND_BASE_URL=http://localhost:5173
